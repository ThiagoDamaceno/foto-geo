    "@electron-toolkit/utils": "^4.0.0",
    "exiftool-vendored": "^37.0.0",
    "lucide-react": "^0.545.0",
    "lucide-static": "^1.27.0",
    "p-limit": "^7.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^39.2.7",
